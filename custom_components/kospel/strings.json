          "heater_ip": "Heater IP address",
          "device_type": "Device model"
        }
      },
      "confirm_device_mismatch": {
        "title": "Unconfirmed device model",
        "description": "The device at this address reported **{detected_model}** (serial: `{serial_number}`), which could not be confirmed as **{selected_model}**. Choose whether to return to setup or force confirmation.",
        "data": {
          "action": "Action"
        }
      },
      "yaml": {
        "title": "YAML development mode",
        "description": "Select the simulated Kospel device model.",
        "data": {
          "device_type": "Simulated device model"
        }
      },
      "http": {
        "title": "Heater connection",
        "description": "Enter the heater IP address and device ID. URL will be http://[IP]/api/dev/[ID].",
        "data": {
          "heater_ip": "Heater IP address",
          "device_id": "Device ID"
        }
      }
    },
    "progress": {
      "discover": "Searching for Kospel devices on your network. This may take a minute."
