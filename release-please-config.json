{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "bootstrap-sha": "24c1432e82a6efb5dd47007ebc929c83636ef4bc",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "ha-kospel-cmi",
      "changelog-path": "CHANGELOG.md",
      "draft": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "include-component-in-tag": false,
      "footer": "\n---\n☕ **Enjoying this integration? / Podoba Ci się ta integracja?**\nI maintain this open-source integration in my private time. If you'd like to say thanks with a coffee / Rozwijam ten projekt w wolnym czasie — jeśli chcesz podziękować kawą ☕: [buycoffee.to/jankrl](https://buycoffee.to/jankrl)",
      "exclude-paths": [
        "lib",
        "uv.lock",
        ".github"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/kospel/manifest.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "lib": {
      "release-type": "python",
      "package-name": "kospel-cmi-lib",
      "component": "lib",
      "changelog-path": "lib/CHANGELOG.md",
      "bump-minor-pre-major": true,
      "include-component-in-tag": true,
      "skip-github-release": true
    }
  }
}
